    a.model_calls = IFNULL(l.llm_call_total, IFNULL(s.model_calls, 0)),
    a.prompt_tokens = IFNULL(l.prompt_tokens, 0),
    a.completion_tokens = IFNULL(l.completion_tokens, 0),
    a.total_tokens = IFNULL(l.total_tokens, 0),
    a.finish_time = NOW()
WHERE a.trace_id = ?
]
